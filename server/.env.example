# Copy this file to .env and fill it in. .env is gitignored — never commit it.

# ---- Database -------------------------------------------------------
# A MongoDB Atlas connection string. Free tier is plenty.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/maklife?retryWrites=true&w=majority

# ---- Server ---------------------------------------------------------
PORT=4000
# Where the React app runs, so CORS lets it through.
CLIENT_ORIGIN=http://localhost:5173

# ---- Visitor IP -----------------------------------------------------
# How many proxies sit in front of this app, so the address recorded on
# a lead is the visitor's rather than the proxy's.
#   0  nothing in front (running it directly)
#   1  one proxy  - Render, Railway, Heroku, a single nginx
#   2  two        - a CDN such as Cloudflare in front of one of those
# Setting this higher than the real number lets a caller fake their IP.
TRUST_PROXY=1

# If a CDN passes the visitor's address in its own header, name it here
# and it is used in preference. Cloudflare: cf-connecting-ip
# Leave BLANK unless a proxy you control always overwrites that header -
# otherwise anyone can send it and choose their own IP.
CLIENT_IP_HEADER=

# ---- Auth -----------------------------------------------------------
# Sign admin tokens. Use a long random string; change it and every admin
# is signed out. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# The account `npm run seed` creates. Change the password after first login.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=change-this-now
SEED_ADMIN_NAME=Administrator

# ---- Company --------------------------------------------------------
COMPANY_NAME=MAK Life Group LLC
COMPANY_PHONE=+1-888-824-9145
COMPANY_EMAIL=info@maklifeinsurancegroup.com
LEAD_PREFIX=MAK

# ---- Email (optional) -----------------------------------------------
# Leave SMTP_HOST blank to skip sending mail entirely — leads are still
# saved, they just do not trigger a notification.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=info@maklifeinsurancegroup.com
